xt\": [","      \"spaCy version: 3.7.4\\n\",","      \"Model: core_web_sm v3.7.1\\n\"","     ]","    }","   ],","   \"source\": [","    \"import spacy\\n\",","    \"from spacy import displacy\\n\",","    \"from pathlib import Path\\n\",","    \"\\n\",","    \"# Load the small English pipeline. This fails with a clear OSError if the\\n\",","    \"# model hasn't been downloaded yet (see README for the download command).\\n\",","    \"nlp = spacy.load(\\\"en_core_web_sm\\\")\\n\",","    \"\\n\",","    \"print(f\\\"spaCy version: {spacy.__version__}\\\")\\n\",","    \"print(f\\\"Model: {nlp.meta['name']} v{nlp.meta['version']}\\\")\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"910859e0\",","   \"metadata\": {},","   \"source\": [","    \"## Cell 2 — Load the sample text\\n\",","    \"\\n\",","    \"A short business-news paragraph mentioning organisations, a person, a\\n\",","    \"location and a date — good variety for demonstrating Named Entity Recognition.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 2,","   \"id\": \"c10da0af\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"Loaded 435 characters\\n\",","      \"Tata Consultancy Services (TCS), headquartered in Mumbai, reported a net profit of\\n\",","      \"â‚¹12,434 crore for Q1 FY2025, a 9% increase year-on-year. CEO K Krithivasan\\n\",","      \"addressed analysts on 11 July 2024, citi\\n\"","     ]","    }","   ],","   \"source\": [","    \"text = Path(\\\"data/sample_text.txt\\\").read_text()\\n\",","    \"\\n\",","    \"print(f\\\"Loaded {len(text)} characters\\\")\\n\",","    \"print(text[:200])\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 3,","   \"id\": \"07e0e0a4-8c24-4d9c-ab06-b6145c6d3d0c\",","   \"metadata\": {},","   \"outputs\": [],","   \"source\": [","    \"## Cell 3 — Run the pipeline\\n\",","    \"\\n\",","    \"#Calling `nlp(text)` runs the *entire* pipeline in one shot: tokenization,\\n\",","    \"#POS tagging, lemmatization, dependency parsing and NER all happen here.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 4,","   \"id\": \"a4dee14a\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"Tokens: 92\\n\",","      \"Sentences: 4\\n\"","     ]","    }","   ],","   \"source\": [","    \"doc = nlp(text)\\n\",","    \"\\n\",","    \"print(f\\\"Tokens: {len(doc)}\\\")\\n\",","    \"print(f\\\"Sentences: {len(list(doc.sents))}\\\")\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"5ceb6749\",","   \"metadata\": {},","   \"source\": [","    \"## Cell 4 — Token table\\n\",","    \"\\n\",","    \"For every alphabetic token, print its text, lemma (dictionary/base form),\\n\",","    \"part-of-speech tag, and whether it's a stop word. This is the classic\\n\",","    \"\\\"tokenize -\u003e lemmatize -\u003e remove stop words\\\" pipeline made visible.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 5,","   \"id\": \"3e810fff\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"TOKEN                LEMMA                POS        STOP   ALPHA \\n\",","      \"-----------------------------------------------------------------\\n\",","      \"Tata                 Tata                 PROPN      False  True  \\n\",","      \"Consultancy          Consultancy          PROPN      False  True  \\n\",","      \"Services             Services             PROPN      False  True  \\n\",","      \"TCS                  TCS                  PROPN      False  True  \\n\",","      \"headquartered        headquarter          VERB       False  True  \\n\",","      \"in                   in                   ADP        True   True  \\n\",","      \"Mumbai               Mumbai               PROPN      False  True  \\n\",","      \"reported             report               VERB       False  True  \\n\",","      \"a                    a                    DET        True   True  \\n\",","      \"net                  net                  ADJ        False  True  \\n\",","      \"profit               profit               NOUN       False  True  \\n\",","      \"of                   of                   ADP        True   True  \\n\",","      \"crore                crore                NOUN       False  True  \\n\",","      \"for                  for                  ADP        True   True  \\n\",","      \"a                    a                    DET        True   True  \\n\",","      \"increase             increase             NOUN       False  True  \\n\",","      \"year                 year                 NOUN       False  True  \\n\",","      \"on                   on                   ADP        True   True  \\n\",","      \"year                 year                 NOUN       False  True  \\n\",","      \"CEO                  ceo                  NOUN       False  True  \\n\",","      \"K                    K                    PROPN      False  True  \\n\",","      \"Krithivasan          Krithivasan          PROPN      False  True  \\n\",","      \"addressed            address              VERB       False  True  \\n\",","      \"analysts             analyst              NOUN       False  True  \\n\",","      \"on                   on                   ADP        True   True  \\n\",","      \"July                 July                 PROPN      False  True  \\n\",","      \"citing               cite                 VERB       False  True  \\n\",","      \"strong               strong               ADJ        False  True  \\n\",","      \"demand               demand               NOUN       False  True  \\n\",","      \"from                 from                 ADP        True   True  \\n\",","      \"North                North                PROPN      False  True  \\n\",","      \"American             american             ADJ        False  True  \\n\",","      \"markets              market               NOUN       False  True  \\n\",","      \"The                  the                  DET        True   True  \\n\",","      \"company              company              NOUN       False  True  \\n\",","      \"plans                plan                 VERB       False  True  \\n\",","      \"to                   to                   PART       True   True  \\n\",","      \"hire                 hire                 VERB       False  True  \\n\",","      \"freshers             fresher              NOUN       False  True  \\n\",","      \"in                   in                   ADP        True   True  \\n\",","      \"as                   as                   ADP        True   True  \\n\",","      \"part                 part                 NOUN       True   True  \\n\",","      \"of                   of                   ADP        True   True  \\n\",","      \"its                  its                  PRON       True   True  \\n\",","      \"workforce            workforce            NOUN       False  True  \\n\",","      \"expansion            expansion            NOUN       False  True  \\n\",","      \"strategy             strategy             NOUN       False  True  \\n\",","      \"Rival                Rival                PROPN      False  True  \\n\",","      \"Infosys              Infosys              PROPN      False  True  \\n\",","      \"based                base                 VERB       False  True  \\n\",","      \"in                   in                   ADP        True   True  \\n\",","      \"Bengaluru            Bengaluru            PROPN      False  True  \\n\",","      \"reported             report               VERB       False  True  \\n\",","      \"flat                 flat                 ADJ        False  True  \\n\",","      \"revenue              revenue              NOUN       False  True  \\n\",","      \"growth               growth               NOUN       False  True  \\n\",","      \"of                   of                   ADP        True   True  \\n\",","      \"in                   in                   ADP        True   True  \\n\",","      \"the                  the                  DET        True   True  \\n\",","      \"same                 same                 ADJ        True   True  \\n\",","      \"period               period               NOUN       False  True  \\n\"","     ]","    }","   ],","   \"source\": [","    \"print(f\\\"{'TOKEN':\u003c20} {'LEMMA':\u003c20} {'POS':\u003c10} {'STOP':\u003c6} {'ALPHA':\u003c6}\\\")\\n\",","    \"print(\\\"-\\\" * 65)\\n\",","    \"\\n\",","    \"# is_alpha=True filters out numbers, punctuation and currency symbols so\\n\",","    \"# the table only shows \\\"real words\\\".\\n\",","    \"for token in doc:\\n\",","    \"    if token.is_alpha:\\n\",","    \"        print(f\\\"{token.text:\u003c20} {token.lemma_:\u003c20} {token.pos_:\u003c10} \\\"\\n\",","    \"              f\\\"{str(token.is_stop):\u003c6} {str(token.is_alpha):\u003c6}\\\")\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"197ff818\",","   \"metadata\": {},","   \"source\": [","    \"## Cell 5 — Named entity extraction\\n\",","    \"\\n\",","    \"`doc.ents` gives every named entity spaCy detected, along with a label\\n\",","    \"(ORG, PERSON, GPE = geo-political entity, DATE, NORP = nationality/religious/\\n\",","    \"political group, etc.).\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 6,","   \"id\": \"340a5023\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"ENTITY                         LABEL         START    END\\n\",","      \"------------------------------------------------------------\\n\",","      \"Tata Consultancy Services      ORG               0     25\\n\",","      \"TCS                            ORG              27     30\\n\",","      \"Mumbai                         GPE              50     56\\n\",","      \"Q1 FY2025                      PRODUCT         103    112\\n\",","      \"9%                             PERCENT         116    118\\n\",","      \"year-on-year                   DATE            128    140\\n\",","      \"K Krithivasan                  PERSON          146    159\\n\",","      \"11 July 2024                   DATE            182    194\\n\",","      \"North American                 NORP            222    236\\n\",","      \"40,000                         CARDINAL        272    278\\n\",","      \"FY2025                         FAC             291    297\\n\",","      \"Infosys                        ORG             349    356\\n\",","      \"Bengaluru                      GPE             367    376\\n\",","      \"2.1%                           PERCENT         410    414\\n\",","      \"\\n\",","      \"Entity type summary: {'ORG': 3, 'GPE': 2, 'PRODUCT': 1, 'PERCENT': 2, 'DATE': 2, 'PERSON': 1, 'NORP': 1, 'CARDINAL': 1, 'FAC': 1}\\n\"","     ]","    }","   ],","   \"source\": [","    \"print(f\\\"{'ENTITY':\u003c30} {'LABEL':\u003c12} {'START':\u003e6} {'END':\u003e6}\\\")\\n\",","    \"print(\\\"-\\\" * 60)\\n\",","    \"for ent in doc.ents:\\n\",","    \"    print(f\\\"{ent.text:\u003c30} {ent.label_:\u003c12} {ent.start_char:\u003e6} {ent.end_char:\u003e6}\\\")\\n\",","    \"\\n\",","    \"# Summarise how many entities of each type were found.\\n\",","    \"from collections import Counter\\n\",","    \"label_counts = Counter(ent.label_ for ent in doc.ents)\\n\",","    \"print(f\\\"\\\\nEntity type summary: {dict(label_counts)}\\\")\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"6513b53a\",","   \"metadata\": {},","   \"source\": [","    \"**Expected entities:** TCS (ORG), Mumbai (GPE), K Krithivasan (PERSON),\\n\",","    \"11 July 2024 (DATE), North American (NORP), Infosys (ORG), Bengaluru (GPE).\"","   ]","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"d4c6217a\",","   \"metadata\": {},","   \"source\": [","    \"## Cell 6 — Sentence similarity\\n\",","    \"\\n\",","    \"spaCy averages the word vectors of a span to get a sentence vector, then\\n\",","    \"computes cosine similarity between two such vectors.\\n\",","    \"\\n\",","    \"**Note:** `en_core_web_sm` does not ship full-size word vectors, so this\\n\",","    \"similarity score is only a rough approximation. `en_core_web_lg` (or a\\n\",","    \"dedicated sentence-embedding model, see Lab 2) gives far better results.\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 7,","   \"id\": \"99180ab7\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"name\": \"stdout\",","     \"output_type\": \"stream\",","     \"text\": [","      \"Sentence 1: Tata Consultancy Services (TCS), headquartered in Mumbai, re...\\n\",","      \"Sentence 2: CEO K Krithivasan\\n\",","      \"addressed analysts on 11 July 2024, citing...\\n\",","      \"Cosine similarity: 0.5916\\n\",","      \"(Note: en_core_web_sm has small vectors — use en_core_web_lg for better similarity)\\n\"","     ]","    },","    {","     \"name\": \"stderr\",","     \"output_type\": \"stream\",","     \"text\": [","      \"C:\\\\Users\\\\Admin\\\\AppData\\\\Local\\\\Temp\\\\ipykernel_24032\\\\963320901.py:5: UserWarning: [W007] The model you're using has no word vectors loaded, so the result of the Span.similarity method will be based on the tagger, parser and NER, which may not give useful similarity judgements. This may happen if you're using one of the small models, e.g. `en_core_web_sm`, which don't ship with word vectors and only use context-sensitive tensors. You can always add your own word vectors, or use one of the larger models instead if available.\\n\",","      \"  similarity = s1.similarity(s2)